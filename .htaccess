# Enable the Rewrite Engine
RewriteEngine On

# Redirect all non-www to www and enforce HTTPS
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^(.*)$ https://www.%{HTTP_HOST}/$1 [R=301,L]

# Redirect /blogs/blogs to /blogs
RewriteRule ^blogs/blogs/?$ /blogs/ [R=301,L]

# Blog post rewrites
RewriteRule ^blogs/posts/([^/]+)/?$ /blogs/posts/$1.html [L]

# Skip rewriting for real files and static assets
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Skip static file extensions entirely
RewriteRule \.(jpg|jpeg|png|gif|css|js|ico|svg|pdf|txt|mp4|webp)$ - [NC,L]

# Route everything else through index.php (which handles .html lookup)
RewriteRule ^(.*)$ /index.php [QSA,L]

# Custom error pages
ErrorDocument 404 /404.html
ErrorDocument 403 /403.html